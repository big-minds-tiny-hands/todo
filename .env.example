# Copy to .env.local. `bunx convex dev` writes the Convex values.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Secret. Build-time only, Vercel Production only. Deploys Convex to production. Keep empty locally.
CONVEX_DEPLOY_KEY=

# Telemetry. Each vendor stays off while its value is empty, and in `next dev`.
# Sentry DSN for the `todo` project in the big-minds-tiny-hands org.
NEXT_PUBLIC_SENTRY_DSN=https://67cf7c79c3e4a5544bcc844dcc773548@o4511112272347136.ingest.us.sentry.io/4512404980236288
# Build-time only. Uploads source maps to Sentry. Leave empty to skip the upload.
SENTRY_AUTH_TOKEN=
# Public PostHog project token (shared project 548413). Ships in the client bundle.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Optional. Defaults to VERCEL_ENV (production, preview), else development.
NEXT_PUBLIC_APP_ENVIRONMENT=

# Social sign-in buttons to show: a comma list of google, microsoft. Keep it in step with the
# provider credentials set on the Convex deployment (see README, Sign-in).
NEXT_PUBLIC_AUTH_PROVIDERS=
