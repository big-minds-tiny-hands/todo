    "cn": "^0.5.2",
    "convex": "^1.49.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.447.6",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
